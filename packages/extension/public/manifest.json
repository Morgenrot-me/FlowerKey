{
  "manifest_version": 3,
  "name": "FlowerKey 花钥",
  "version": "1.0.2",
  "description": "离线确定性密码生成与端到端加密秘密库。主密码永不上传，支持 WebDAV 自托管同步。",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "sidePanel"
  ],
  "action": {},
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/index.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
